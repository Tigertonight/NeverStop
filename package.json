{
  "name": "neverstop-motion-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": ".venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "test:api": ".venv/bin/python -m unittest discover -s backend/tests -p 'test_*.py' -v",
    "lint:api": ".venv/bin/ruff check backend",
    "eval:api": ".venv/bin/python -m backend.eval.run_eval",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "7.2.4",
    "vitest": "^3.2.7"
  }
}
